{
  "name": "@povio/trustmailer",
  "version": "0.1.1",
  "description": "Rust-powered, nodemailer-compatible mail library — native addon via napi-rs, runs on Node.js, Bun, and Deno unmodified",
  "homepage": "https://trustmailer.nesgarbo.com",
  "author": "Nestor Garcia <admin@nesgarbo.com> (https://nesgarbo.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/povio/trustmailer.git",
    "directory": "crates/trustmailer-node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "files": [
    "index.js",
    "index.d.ts",
    "trustmailer.*.node",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "LICENSE-MIMALLOC"
  ],
  "napi": {
    "name": "trustmailer",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node smoke-test.cjs && node render-test.cjs",
    "test:bun": "bun smoke-test.cjs && bun render-test.cjs",
    "test:deno": "deno run -A smoke-test.cjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
