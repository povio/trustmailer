{
  "name": "trustmailer",
  "version": "0.1.0",
  "description": "Rust-powered, nodemailer-compatible mail library — native addon via napi-rs, runs on Node.js, Bun, and Deno unmodified",
  "homepage": "https://nesgarbo.com/packages",
  "author": "Nestor Garcia <admin@nesgarbo.com> (https://nesgarbo.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nesgarbo/trustmailer.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "name": "trustmailer",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "engines": {
    "node": ">= 16"
  },
  "optionalDependencies": {
    "trustmailer-darwin-arm64": "0.1.0",
    "trustmailer-darwin-x64": "0.1.0",
    "trustmailer-linux-x64-gnu": "0.1.0",
    "trustmailer-linux-x64-musl": "0.1.0",
    "trustmailer-linux-arm64-gnu": "0.1.0",
    "trustmailer-linux-arm64-musl": "0.1.0",
    "trustmailer-win32-x64-msvc": "0.1.0",
    "trustmailer-win32-arm64-msvc": "0.1.0"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node smoke-test.cjs",
    "test:bun": "bun smoke-test.cjs",
    "test:deno": "deno run -A smoke-test.cjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3"
  }
}
